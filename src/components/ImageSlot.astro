---
/**
 * A photo slot. Put a photo in src/assets/photos/ with the file name given in `photo`
 * (e.g. "storefront.jpg") and it appears here automatically, resized and converted to AVIF/WebP.
 * Until then, a styled crown panel shows (while previewing locally it also shows which file name to add).
 */
import { Picture } from 'astro:assets';
import { findPhoto, photoCredit } from '../lib/photos';

interface Props {
  photo?: string;
  alt: string;
  class?: string;
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  tone?: 'dark' | 'light';
  /** Show the faint crown in the empty placeholder. */
  motif?: boolean;
}

const { photo = '', alt: pageAlt, class: className, aspect = 'aspect-[4/3]', sizes = '(min-width: 1024px) 50vw, 100vw', eager = false, tone = 'dark', motif = true } = Astro.props;

const image = findPhoto(photo);
// Stock photos describe what's actually pictured; your own photos use the page's description.
// An empty alt means decorative (e.g. category tiles whose link text already says it).
const alt = pageAlt ? (photoCredit(photo)?.alt ?? pageAlt) : '';
---
{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600].filter((w) => w <= image.width)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class:list={['h-full w-full object-cover', aspect, className]}
  />
) : (
  <div
    class:list={[
      'relative flex h-full w-full items-center justify-center overflow-hidden',
      tone === 'dark' ? 'photo-ph-dark' : 'photo-ph-light',
      aspect,
      className,
    ]}
    role={alt ? 'img' : undefined}
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
    data-photo-slot={photo}
  >
    {motif && <svg class:list={['h-1/4 max-h-24 w-1/4 max-w-24', tone === 'dark' ? 'text-gold/25' : 'text-burgundy/20']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
      <path d="M3 18V8l5 4 4-7 4 7 5-4v10z" /><path d="M3 21h18" />
    </svg>}
    {import.meta.env.DEV && (
      <span class="absolute left-3 top-3 rounded-md bg-black/45 px-2.5 py-1 font-mono text-[0.7rem] tracking-wide text-cream/90">
        Photo slot: {photo || 'add a photo'}
      </span>
    )}
  </div>
)}

<style>
  .photo-ph-dark {
    background:
      radial-gradient(ellipse at 30% 20%, rgb(201 164 92 / 0.22), transparent 60%),
      radial-gradient(ellipse at 80% 90%, rgb(122 31 43 / 0.45), transparent 55%),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 14px),
      #211b19;
  }
  .photo-ph-light {
    background:
      radial-gradient(ellipse at 30% 20%, rgb(201 164 92 / 0.25), transparent 60%),
      repeating-linear-gradient(135deg, rgb(20 17 16 / 0.04) 0 2px, transparent 2px 14px),
      #ece2d0;
  }
</style>

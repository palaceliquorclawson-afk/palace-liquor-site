---
/**
 * A photo slot. Put a photo in src/assets/photos/ with the file name given in `photo`
 * (e.g. "storefront.jpg") and it appears here automatically, resized and converted to AVIF/WebP.
 * Until then, a styled placeholder shows which file name to add.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  photo?: string;
  alt: string;
  class?: string;
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  tone?: 'dark' | 'light';
}

const { photo = '', alt, class: className, aspect = 'aspect-[4/3]', sizes = '(min-width: 1024px) 50vw, 100vw', eager = false, tone = 'dark' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const match = photo ? Object.entries(files).find(([p]) => p.split('/').pop()?.toLowerCase() === photo.toLowerCase()) : undefined;
const image = match?.[1].default;
---
{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600].filter((w) => w <= image.width)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class:list={['h-full w-full object-cover', aspect, className]}
  />
) : (
  <div
    class:list={[
      'relative flex h-full w-full items-start overflow-hidden',
      tone === 'dark' ? 'photo-ph-dark text-cream/70' : 'photo-ph-light text-muted',
      aspect,
      className,
    ]}
    role="img"
    aria-label={alt}
  >
    <span class="m-3 rounded-md bg-black/35 px-2.5 py-1 font-mono text-[0.7rem] tracking-wide text-cream/85 backdrop-blur-sm">
      Photo slot: {photo || 'add a photo'}
    </span>
  </div>
)}

<style>
  .photo-ph-dark {
    background:
      radial-gradient(ellipse at 30% 20%, rgb(201 164 92 / 0.22), transparent 60%),
      radial-gradient(ellipse at 80% 90%, rgb(122 31 43 / 0.45), transparent 55%),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 14px),
      #211b19;
  }
  .photo-ph-light {
    background:
      radial-gradient(ellipse at 30% 20%, rgb(201 164 92 / 0.25), transparent 60%),
      repeating-linear-gradient(135deg, rgb(20 17 16 / 0.04) 0 2px, transparent 2px 14px),
      #ece2d0;
  }
</style>

---
/**
 * "Are you 21 or older?" gate.
 * The page content stays hidden (html.age-pending) until the visitor confirms.
 * The answer is remembered for 30 days in localStorage, falling back to a cookie,
 * and finally to memory for the current page if both are blocked.
 * The tiny inline script in BaseLayout <head> removes the gate before first paint
 * for returning visitors, so there's no flash.
 */
import { site } from '../site.config';
---
<div
  id="age-gate"
  class="fixed inset-0 z-[100] grid place-items-center overflow-y-auto bg-ink px-4 py-8"
  role="dialog"
  aria-modal="true"
  aria-labelledby="age-gate-title"
  aria-describedby="age-gate-desc"
>
  <div class="w-full max-w-md rounded-2xl border border-gold/30 bg-ink-2 p-8 text-center text-cream shadow-2xl sm:p-10">
    <svg class="mx-auto mb-5 h-12 w-12 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M3 18V8l5 4 4-7 4 7 5-4v10z" /><path d="M3 21h18" />
    </svg>
    <p class="eyebrow text-gold">{site.legalName}</p>
    <h2 id="age-gate-title" class="mt-3 text-3xl sm:text-4xl">Are you 21 or older?</h2>
    <p id="age-gate-desc" class="mt-3 text-cream/80">You must be of legal drinking age to enter this site.</p>

    <div class="mt-7 grid grid-cols-2 gap-3" data-age-buttons>
      <button type="button" class="btn btn-gold w-full" data-age-yes>Yes, I'm 21+</button>
      <button type="button" class="btn btn-outline-light w-full" data-age-no>No</button>
    </div>
    <p class="mt-5 hidden font-medium text-gold-light" data-age-denied role="alert">
      Sorry, you must be 21 or older to visit this site. Come back when you're of age.
    </p>
    <noscript>
      <p class="mt-5 text-cream/85">
        Please turn on JavaScript to confirm your age, or call us at
        <a class="underline" href={`tel:${site.phoneE164}`}>{site.phone}</a>.
      </p>
    </noscript>
    <p class="mt-7 text-xs text-cream/60">Please enjoy responsibly.</p>
  </div>
</div>

<script>
  const KEY = 'palace_age_ok';
  const DAYS = 30;
  const root = document.documentElement;
  const gate = document.getElementById('age-gate');
  const site = document.querySelector<HTMLElement>('.site-content');

  function remember() {
    const expires = Date.now() + DAYS * 864e5;
    try { localStorage.setItem(KEY, String(expires)); } catch {}
    try { document.cookie = `${KEY}=1; max-age=${DAYS * 86400}; path=/; SameSite=Lax`; } catch {}
  }

  function unlock() {
    root.classList.remove('age-pending');
    site?.removeAttribute('inert');
    site?.removeAttribute('aria-hidden');
  }

  if (root.classList.contains('age-pending') && gate) {
    site?.setAttribute('inert', '');
    site?.setAttribute('aria-hidden', 'true');
    const yes = gate.querySelector<HTMLButtonElement>('[data-age-yes]');
    yes?.focus();

    yes?.addEventListener('click', () => {
      remember();
      unlock();
      document.querySelector<HTMLElement>('#main')?.focus({ preventScroll: true });
    });
    gate.querySelector('[data-age-no]')?.addEventListener('click', () => {
      gate.querySelector('[data-age-denied]')?.classList.remove('hidden');
    });
    // Keep keyboard focus inside the gate.
    gate.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const buttons = [...gate.querySelectorAll<HTMLElement>('button')];
      const first = buttons[0];
      const last = buttons[buttons.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>

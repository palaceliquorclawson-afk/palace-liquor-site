---
/**
 * Page banner.
 * - tone "light" (default): warm white, headline left, arched photo right (if `photo` exists).
 * - tone "burgundy": bold red band, no photo (events page).
 * - tone "cinematic": full-bleed photo under the (transparent) header, headline over it (home).
 * - banner: headline on top, then the photo full width and uncropped (for wide ~2:1 photos).
 * `photo` is a file name in src/assets/photos/ (e.g. "hero-cigars.webp").
 * Everything on the first screen animates in with CSS on load (see global.css "Motion").
 */
import { Picture } from 'astro:assets';
import { findPhoto, photoCredit } from '../lib/photos';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  photo?: string;
  photoAlt?: string;
  size?: 'home' | 'page';
  tone?: 'light' | 'burgundy' | 'cinematic';
  banner?: boolean;
}
const { eyebrow, title, subtitle, photo, photoAlt = '', size = 'page', tone = 'light', banner = false } = Astro.props;
const image = findPhoto(photo);
const alt = photoCredit(photo)?.alt ?? photoAlt;
const red = tone === 'burgundy';
const cine = tone === 'cinematic' && image;
const side = tone === 'light' && !banner && image;
const wide = tone === 'light' && banner && image;
---
{cine ? (
  <section class="hero-cinematic relative isolate flex flex-col overflow-hidden bg-ink text-cream">
    <div class="container-x relative z-10 pb-12 pt-6 sm:pb-14 lg:pb-12 lg:pt-10">
      {eyebrow && <p class="eyebrow anim-rise text-gold-light">{eyebrow}</p>}
      <h1 class="hero-title-on-photo anim-rise mt-4 text-display lg:mt-5" style="--d:120ms" set:html={title} />
      <div class="mt-6 flex flex-col gap-7 lg:mt-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
        {subtitle && <p class="anim-rise max-w-lg text-lg text-cream/80 sm:text-xl" style="--d:240ms">{subtitle}</p>}
        <div class="anim-rise flex-none" style="--d:360ms"><slot /></div>
      </div>
    </div>
    <div class="hero-photo anim-unveil relative order-first lg:order-none" style="--d:200ms">
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1448].filter((w) => w <= image.width)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="anim-settle absolute inset-0 h-full w-full object-cover"
      />
      <div class="hero-fade-top pointer-events-none absolute inset-x-0 top-0" aria-hidden="true"></div>
      <div class="hero-fade-bot pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true"></div>
    </div>
  </section>
) : (
  <section
    class:list={[
      'relative isolate overflow-hidden',
      red ? 'bg-burgundy text-cream' : 'bg-cream text-ink',
      size === 'home' ? 'py-14 sm:py-20' : 'py-12 sm:py-20',
    ]}
  >
    {red && (
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full border border-gold/25"></div>
        <div class="absolute -right-4 -top-12 h-64 w-64 rounded-full border border-gold/20"></div>
        <div class="absolute -bottom-40 -left-32 h-96 w-96 rounded-full border border-gold/15"></div>
      </div>
    )}

    <div class:list={['container-x', red && 'text-center']}>
      <div class:list={[side && 'grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16']}>
        <div class:list={[red && 'mx-auto max-w-3xl']}>
          {eyebrow && <p class:list={['eyebrow anim-rise', red ? 'text-gold-light' : 'text-brass']}>{eyebrow}</p>}
          <h1
            class:list={[
              'anim-rise mt-4',
              !red && 'hero-title',
              red ? 'text-display uppercase' : size === 'home' ? 'text-display' : 'text-h1',
            ]}
            style="--d:100ms"
            set:html={title}
          />
          {subtitle && (
            <p class:list={['anim-rise mt-5 text-lg sm:text-xl', red ? 'mx-auto max-w-2xl text-cream/90' : 'max-w-xl text-muted']} style="--d:200ms">
              {subtitle}
            </p>
          )}
          <div class:list={['anim-rise mt-8', red && 'flex justify-center']} style="--d:300ms"><slot /></div>
        </div>

        {side && (
          <div class="arch anim-unveil mx-auto w-full max-w-sm lg:max-w-none" style="--d:150ms">
            <Picture
              src={image}
              alt={alt}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200].filter((w) => w <= image.width)}
              sizes="(min-width: 1024px) 45vw, 90vw"
              loading="eager"
              fetchpriority="high"
              class:list={['anim-settle h-full w-full object-cover', size === 'home' ? 'aspect-[4/5]' : 'aspect-[4/4.2]']}
            />
          </div>
        )}
      </div>

      {wide && (
        <div class="anim-unveil mt-10 overflow-hidden rounded-2xl border border-gold/45 shadow-sm sm:mt-12" style="--d:200ms">
          <Picture
            src={image}
            alt={alt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1400, 1932].filter((w) => w <= image.width)}
            sizes="(min-width: 1184px) 1120px, calc(100vw - 2.5rem)"
            loading="eager"
            fetchpriority="high"
            class="anim-settle block h-auto w-full"
          />
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* Dark hero that starts under the sticky header. Desktop: text, then the storefront edge to edge.
     Phones: the storefront first (so the sign shows on the first screen), fading into the text. */
  .hero-cinematic {
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
  }
  .hero-photo { width: 100%; height: min(42vw, 70svh); overflow: hidden; }
  .hero-photo :global(img) { object-position: 50% 78%; }
  .hero-fade-top { top: -1px; height: 34%; background: linear-gradient(to bottom, var(--color-ink), transparent); }
  .hero-fade-bot { bottom: -1px; height: 22%; background: linear-gradient(to top, rgb(30 26 24 / .55), transparent); }
  @media (max-width: 1023px) {
    .hero-photo { height: min(72vw, 52svh); }
    .hero-photo :global(img) { object-position: 58% 52%; }
    .hero-fade-top { height: 22%; opacity: .7; }
    .hero-fade-bot { height: 40%; background: linear-gradient(to top, var(--color-ink), transparent); }
  }
</style>

---
/**
 * Page banner.
 * - tone "light" (default): warm white, headline left, arched photo right (if `photo` exists).
 * - tone "burgundy": bold red band, no photo (events page).
 * - banner: headline on top, then the photo full width and uncropped (for wide ~2:1 photos).
 * `photo` is a file name in src/assets/photos/ (e.g. "hero-cigars.webp").
 */
import { Picture } from 'astro:assets';
import { findPhoto, photoCredit } from '../lib/photos';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  photo?: string;
  photoAlt?: string;
  size?: 'home' | 'page';
  tone?: 'light' | 'burgundy';
  banner?: boolean;
}
const { eyebrow, title, subtitle, photo, photoAlt = '', size = 'page', tone = 'light', banner = false } = Astro.props;
const image = findPhoto(photo);
const alt = photoCredit(photo)?.alt ?? photoAlt;
const red = tone === 'burgundy';
const side = !red && !banner && image;
const wide = !red && banner && image;
---
<section
  class:list={[
    'relative isolate overflow-hidden',
    red ? 'bg-burgundy text-cream' : 'bg-cream text-ink',
    size === 'home' ? 'py-14 sm:py-20' : 'py-12 sm:py-16',
  ]}
>
  {red && (
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full border border-gold/25"></div>
      <div class="absolute -right-4 -top-12 h-64 w-64 rounded-full border border-gold/20"></div>
      <div class="absolute -bottom-40 -left-32 h-96 w-96 rounded-full border border-gold/15"></div>
    </div>
  )}

  <div class:list={['container-x', red && 'text-center']}>
    <div class:list={[side && 'grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16']}>
      <div class:list={[red && 'mx-auto max-w-3xl']}>
        {eyebrow && <p class:list={['eyebrow', red ? 'text-gold-light' : 'text-brass']}>{eyebrow}</p>}
        <h1
          class:list={[
            'mt-4',
            !red && 'hero-title',
            red ? 'text-display uppercase' : size === 'home' ? 'text-display' : 'text-h1',
          ]}
          set:html={title}
        />
        {subtitle && (
          <p class:list={['mt-5 text-lg sm:text-xl', red ? 'mx-auto max-w-2xl text-cream/90' : 'max-w-xl text-muted']}>
            {subtitle}
          </p>
        )}
        <div class:list={['mt-8', red && 'flex justify-center']}><slot /></div>
      </div>

      {side && (
        <div class="arch mx-auto w-full max-w-sm lg:max-w-none">
          <Picture
            src={image}
            alt={alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200].filter((w) => w <= image.width)}
            sizes="(min-width: 1024px) 45vw, 90vw"
            loading="eager"
            fetchpriority="high"
            class:list={['h-full w-full object-cover', size === 'home' ? 'aspect-[4/5]' : 'aspect-[4/4.2]']}
          />
        </div>
      )}
    </div>

    {wide && (
      <div class="mt-10 overflow-hidden rounded-2xl border border-gold/45 shadow-sm sm:mt-12">
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']}
          widths={[640, 960, 1400, 1932].filter((w) => w <= image.width)}
          sizes="(min-width: 1152px) 1104px, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
    )}
  </div>
</section>

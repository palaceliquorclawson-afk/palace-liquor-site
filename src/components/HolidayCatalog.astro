---
/**
 * The Holiday Catalog itself, shared by two pages so they never drift apart:
 * - /holiday-catalog/ (ads=false): full site header/footer, in the menu and sitemap.
 * - /holiday/ (ads=true): cigar-free Google Ads copy - slim AdsHeader/AdsFooter, noindex,
 *   canonical to /holiday-catalog/, links only to the other cigar-free ads pages.
 * Built from src/data/gift-sets.json, so prices and items change by editing that one file.
 * Photos live in src/assets/gift-sets/ (file name = the "image" field without "images/");
 * a card shows a placeholder until its photo exists.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AdsHeader from './AdsHeader.astro';
import AdsFooter from './AdsFooter.astro';
import HoursTable from './HoursTable.astro';
import Icon from './Icon.astro';
import { site, telHref, directionsUrl, isPlaceholder } from '../site.config';
import data from '../data/gift-sets.json';

interface Props {
  /** Cigar-free Google Ads version: slim header/footer, links only to cigar-free pages. */
  ads?: boolean;
}
const { ads = false } = Astro.props;

type Item = {
  category: string;
  name: string;
  tagline?: string | null;
  size?: string | null;
  abv?: string | null;
  price?: string | null;
  badges?: string[];
  includes?: string[];
  includes_label?: string | null;
  image?: string | null;
  image_width?: number;
  image_height?: number;
  alt?: string | null;
};

const hasDoorDash = !isPlaceholder(site.doordashUrl);

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gift-sets/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photos = new Map(Object.entries(files).map(([path, mod]) => [path.split('/').pop()!.toLowerCase(), mod.default]));
const photoFor = (image?: string | null) => (image ? photos.get(image.split('/').pop()!.toLowerCase()) : undefined);

const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const items = data.items as Item[];
const sections = data.categories
  .map((name) => ({ name, id: `gs-${slug(name)}`, items: items.filter((i) => i.category === name) }))
  .filter((s) => s.items.length > 0);

// Text the search box matches against (accents stripped, so "patron" finds "Patrón").
const searchText = (i: Item) =>
  [i.name, i.tagline, i.category, i.size, ...(i.badges ?? []), ...(i.includes ?? [])]
    .filter(Boolean)
    .join(' ')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '');
---
{ads && <AdsHeader />}

<!-- Hero + the three actions (same as /liquor-store/) -->
<section class="bg-cream py-12 sm:py-16">
  <div class="container-x">
    <p class="eyebrow text-brass">{site.address.city}, Michigan</p>
    <h1 class="mt-4 text-h1">Holiday Catalog</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">
      Boxed with glasses, minis, games and cocktail extras. Gift sets are priced the same as the bottle, so there is no gift surcharge.
    </p>

    <div class="mt-8 grid gap-3 sm:max-w-xl">
      <a href={telHref} class="btn btn-primary w-full px-8 py-4 text-lg">
        <Icon name="phone" class="h-5 w-5" /> Call {site.phone}
      </a>
      <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark w-full px-8 py-4 text-lg">
        <Icon name="pin" class="h-5 w-5" /> Get Directions<span class="sr-only"> (opens in a new tab)</span>
      </a>
      {hasDoorDash && (
        <a
          href={site.doordashUrl}
          target="_blank"
          rel="noopener noreferrer"
          onclick="gtag_report_conversion(); return true;"
          class="btn btn-primary w-full px-8 py-4 text-lg"
        >
          <Icon name="bag" class="h-5 w-5" /> Order on DoorDash<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>
</section>

<!-- Sticky search + Categories menu -->
<div class:list={["sticky z-40 border-y border-line bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85", ads ? "top-16" : "top-[7.25rem]"]} data-gs-bar>
  <div class="container-x flex items-center gap-3 py-3">
    <label class="relative flex-1">
      <span class="sr-only">Search the Holiday Catalog</span>
      <Icon name="search" class="pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted" />
      <input
        type="search"
        class="field text-ellipsis pl-10"
        placeholder="Search the catalog (brand, glass, game...)"
        autocomplete="off"
        data-gs-search
      />
    </label>
    <div class="relative">
      <button
        type="button"
        class="btn btn-outline-dark min-h-12 px-4"
        aria-expanded="false"
        aria-controls="gs-categories"
        data-gs-menu-toggle
      >
        <Icon name="menu" class="h-5 w-5" /> <span>Categories</span>
      </button>
      <nav
        id="gs-categories"
        aria-label="Catalog categories"
        class="absolute right-0 top-full mt-2 hidden max-h-[70dvh] w-64 overflow-y-auto rounded-xl border border-line bg-paper p-2 shadow-xl"
        data-gs-menu
      >
        <ul>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="flex min-h-11 items-center justify-between gap-3 rounded-lg px-3 hover:bg-cream-2" data-gs-jump={s.id}>
                <span class="font-medium">{s.name}</span>
                <span class="rounded-full bg-cream-2 px-2 py-0.5 text-sm tabular-nums text-muted">{s.items.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</div>

<!-- One section per category, in the JSON's order -->
<div class="py-10 sm:py-14">
  <div class="container-x">
    <p class="hidden rounded-xl border border-line bg-paper p-6 text-lg text-muted" role="status" data-gs-empty>
      Nothing in the catalog matches your search. Try another word, or call {site.phone} and we'll check for you.
    </p>
    {sections.map((s, si) => (
      <section id={s.id} class:list={["gs-section pb-10", ads && "gs-ads"]} aria-labelledby={`${s.id}-title`} data-gs-section>
        <h2 id={`${s.id}-title`} class="text-h2">{s.name}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {s.items.map((item, ii) => {
            const photo = photoFor(item.image);
            const eager = si === 0 && ii < 3;
            return (
              <li class="card flex flex-col overflow-hidden" data-gs-item data-search={searchText(item)}>
                <div class="relative aspect-[4/5] bg-[#efe3d0]">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={item.alt ?? ''}
                      width={item.image_width ?? photo.width}
                      height={item.image_height ?? photo.height}
                      widths={[320, 480, 640].filter((w) => w <= photo.width)}
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      loading={eager ? 'eager' : 'lazy'}
                      class="absolute inset-0 h-full w-full object-contain"
                    />
                  ) : (
                    <div class="grid h-full place-items-center text-burgundy/40" aria-hidden="true">
                      <Icon name="spirits" class="h-16 w-16" />
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col p-5">
                  {item.badges && item.badges.length > 0 && (
                    <ul class="mb-3 flex flex-wrap gap-1.5" aria-label="Highlights">
                      {item.badges.map((b) => <li class="rounded-full bg-burgundy px-2.5 py-0.5 text-xs font-semibold text-cream">{b}</li>)}
                    </ul>
                  )}
                  <h3 class="text-xl">{item.name}</h3>
                  {item.tagline && <p class="mt-1 text-muted">{item.tagline}</p>}
                  {(item.size || item.abv) && (
                    <p class="mt-2 text-sm font-medium text-ink">
                      {[item.size, item.abv && `${item.abv} ABV`].filter(Boolean).join(' · ')}
                    </p>
                  )}
                  {item.includes && item.includes.length > 0 && (
                    <div class="mt-4">
                      <p class="text-sm font-semibold uppercase tracking-wider text-brass">{item.includes_label || "What's included"}</p>
                      <ul class="mt-2 grid gap-1.5">
                        {item.includes.map((inc) => (
                          <li class="flex gap-2 text-sm"><Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-burgundy" /> {inc}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {item.price && <p class="mt-auto pt-5 font-display text-3xl font-bold text-burgundy">{item.price}</p>}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    <p class="text-lg text-muted">Prices and availability change. Call <a href={telHref} class="font-semibold text-burgundy underline">{site.phone}</a> or stop in.</p>
    <p class="mt-2 font-semibold">Must be 21+ with valid ID.</p>
  </div>
</div>

<!-- Party planning -->
<section class="bg-burgundy py-14 text-cream sm:py-20" aria-labelledby="party-title">
  <div class="container-x">
    <p class="eyebrow text-gold-light">Events &amp; catering</p>
    <h2 id="party-title" class="mt-3 text-h2">Planning a party?</h2>
    <p class="mt-4 max-w-2xl text-lg text-cream/90">
      Kegs and table rentals, and full event orders: tell us your guest count and we'll recommend exactly
      what you need, then deliver it.
    </p>
    <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-gold/50 bg-black/20 px-5 py-2.5 font-semibold text-gold-light">
      <Icon name="ice" class="h-5 w-5 flex-none" /> {site.cateringOffer.text}
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={ads ? "/party-drinks/" : "/events-catering/"} class="btn btn-gold">Plan your event <Icon name="arrow" class="h-5 w-5" /></a>
      <a href={ads ? "/keg-rentals/" : "/kegs-rentals/"} class="btn btn-outline-light">Kegs &amp; table rentals</a>
    </div>
  </div>
</section>

<!-- Hours -->
<section class="py-14 sm:py-20" aria-labelledby="hours-title">
  <div class="container-x max-w-2xl">
    <h2 id="hours-title" class="text-h2">Open 7 days a week.</h2>
    <div class="mt-6"><HoursTable /></div>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href={telHref} class="btn btn-primary"><Icon name="phone" class="h-5 w-5" /> Call {site.phone}</a>
      <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark">
        <Icon name="pin" class="h-5 w-5" /> Get Directions<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>

{ads && <AdsFooter />}

<style>
  /* Clear the sticky header (site header ~7.25rem, slim ads header 4rem) and search bar when jumping to a category. */
  .gs-section { scroll-margin-top: 13rem; }
  .gs-section.gs-ads { scroll-margin-top: 9.5rem; }
</style>

<script>
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();

  // Live search: hide cards that don't match every word, and sections left empty.
  const search = document.querySelector<HTMLInputElement>('[data-gs-search]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-gs-section]')];
  const empty = document.querySelector<HTMLElement>('[data-gs-empty]');
  function filter() {
    const words = norm(search?.value ?? '').split(/\s+/).filter(Boolean);
    let any = false;
    for (const sec of sections) {
      let shown = 0;
      for (const card of sec.querySelectorAll<HTMLElement>('[data-gs-item]')) {
        const hit = words.every((w) => (card.dataset.search ?? '').includes(w));
        card.hidden = !hit;
        if (hit) shown++;
      }
      sec.hidden = shown === 0;
      if (shown) any = true;
    }
    empty?.classList.toggle('hidden', any);
  }
  search?.addEventListener('input', filter);

  // Categories menu: toggle, jump, and close on Escape or a tap outside.
  const toggle = document.querySelector<HTMLButtonElement>('[data-gs-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-gs-menu]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (menu && toggle && !menu.contains(t) && !toggle.contains(t)) setOpen(false);
  });
  menu?.querySelectorAll<HTMLAnchorElement>('[data-gs-jump]').forEach((a) => {
    a.addEventListener('click', () => {
      // If a search has hidden this category, clear it so the jump lands on visible cards.
      const target = document.getElementById(a.dataset.gsJump ?? '');
      if (target?.hidden && search) { search.value = ''; filter(); }
      setOpen(false);
    });
  });
</script>

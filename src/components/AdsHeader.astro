---
/**
 * Slim header for the cigar-free Google Ads pages (/liquor-store/, /party-drinks/, /keg-rentals/).
 * Use with <BaseLayout chrome="none">: it has no site navigation, so it never links to the cigars page.
 */
import Icon from './Icon.astro';
import { site, telHref } from '../site.config';
---
<header class="sticky top-0 z-50 border-b border-line bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85">
  <div class="container-x flex h-16 items-center justify-between gap-2 sm:gap-3">
    <span class="flex items-center gap-2.5">
      <Icon name="crown" class="h-7 w-7 flex-none text-burgundy" />
      <span>
        <span class="block font-display text-xl font-bold leading-none">Palace <span class="text-burgundy">Liquor</span></span>
        <span class="mt-1 block whitespace-nowrap text-[0.6rem] font-semibold uppercase tracking-[0.22em] text-muted">Clawson · Michigan</span>
      </span>
    </span>
    <div class="flex items-center gap-2.5 sm:gap-5">
      <a href={telHref} class="btn btn-primary px-3 text-sm sm:px-6 sm:text-base">
        <Icon name="phone" class="h-5 w-5" />
        <span class="hidden sm:inline">{site.phone}</span>
        <span class="sm:hidden max-[359px]:sr-only">Call</span>
      </a>
    </div>
  </div>
</header>

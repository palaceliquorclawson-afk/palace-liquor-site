---
import ImageSlot from './ImageSlot.astro';
import Icon from './Icon.astro';
import type { ComponentProps } from 'astro/types';
interface Props { title: string; blurb: string; href: string; photo: string; icon: ComponentProps<typeof Icon>['name']; index?: number }
const { title, blurb, href, photo, icon, index = 1 } = Astro.props;
---
<a
  href={href}
  class="card group reveal flex flex-col overflow-hidden transition-colors hover:border-burgundy/40"
>
  <div class="overflow-hidden">
    <ImageSlot
      photo={photo}
      alt=""
      tone="light"
      aspect="aspect-[16/11]"
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="transition-transform duration-700 group-hover:scale-[1.04]"
    />
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center gap-2">
      <span class="font-display text-sm font-bold text-brass">{String(index).padStart(2, '0')}</span>
      <Icon name={icon} class="h-5 w-5 text-brass/80" />
    </div>
    <h3 class="mt-2 text-xl text-burgundy sm:text-2xl">{title}</h3>
    <p class="mt-1 flex-1 text-[0.95rem] text-muted">{blurb}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.14em] text-ink">
      Explore <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>

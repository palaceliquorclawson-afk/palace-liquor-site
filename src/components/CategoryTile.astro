---
import ImageSlot from './ImageSlot.astro';
import Icon from './Icon.astro';
import type { ComponentProps } from 'astro/types';
interface Props { title: string; blurb: string; href: string; photo: string; icon: ComponentProps<typeof Icon>['name'] }
const { title, blurb, href, photo, icon } = Astro.props;
---
<a href={href} class="group reveal relative block overflow-hidden rounded-2xl bg-ink text-cream">
  <ImageSlot photo={photo} alt="" aspect="aspect-[4/5] sm:aspect-[3/4]" sizes="(min-width: 1024px) 33vw, 50vw" class="transition-transform duration-700 group-hover:scale-[1.04]" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6">
    <Icon name={icon} class="h-7 w-7 text-gold" />
    <h3 class="mt-2 text-xl sm:text-2xl">{title}</h3>
    <p class="mt-1 hidden text-sm text-cream/80 sm:block">{blurb}</p>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-gold">
      Explore <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>

---
/**
 * "Look inside" store tour. A pulsing marker on the storefront photo opens a full-screen
 * viewer that steps through the photos in src/data/tour.json (aisles, displays, the buffalo).
 * The marker is positioned in JS so it stays on the door however the hero photo is cropped.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { findPhoto } from '../lib/photos';
import tour from '../data/tour.json';

/** Where the door sits in the hero photo, as a fraction of its width and height. */
const { x, y } = tour.marker;
const stops = tour.stops.map((s) => ({ ...s, image: findPhoto(s.photo) })).filter((s) => s.image);
---
{stops.length > 0 && (
  <>
    <button
      type="button"
      class="tour-marker"
      style={`--mx:${x};--my:${y}`}
      data-tour-open
      aria-haspopup="dialog"
      aria-controls="store-tour"
    >
      <span class="tour-ring" aria-hidden="true"></span>
      <span class="tour-ring tour-ring-2" aria-hidden="true"></span>
      <span class="tour-dot" aria-hidden="true"></span>
      <span class="tour-label">Look inside</span>
    </button>

    <dialog id="store-tour" class="tour" aria-label="Inside Palace Liquor">
      <div class="tour-stage">
        {stops.map((s, i) => (
          <figure class="tour-slide" data-slide={i} hidden={i !== 0}>
            <Picture
              src={s.image}
              alt={s.alt ?? s.title}
              formats={['avif', 'webp']}
              widths={[800, 1200, 1600].filter((w) => w <= s.image.width)}
              sizes="100vw"
              loading="lazy"
              class="h-full w-full object-contain"
            />
            <figcaption>
              <span class="eyebrow text-gold-light">{String(i + 1).padStart(2, '0')} / {String(stops.length).padStart(2, '0')}</span>
              <span class="tour-title">{s.title}</span>
              {s.note && <span class="tour-note">{s.note}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
      <button type="button" class="tour-btn tour-close" data-tour-close aria-label="Close tour"><Icon name="close" class="h-6 w-6" /></button>
      {stops.length > 1 && (
        <>
          <button type="button" class="tour-btn tour-prev" data-tour-prev aria-label="Previous"><Icon name="arrow" class="h-6 w-6 rotate-180" /></button>
          <button type="button" class="tour-btn tour-next" data-tour-next aria-label="Next"><Icon name="arrow" class="h-6 w-6" /></button>
          <div class="tour-dots" role="tablist" aria-label="Tour stops">
            {stops.map((s, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={s.title} data-tour-go={i}></button>)}
          </div>
        </>
      )}
    </dialog>
  </>
)}

<style>
  /* Marker on the door */
  .tour-marker {
    position: absolute; left: 0; top: 0; z-index: 2;
    display: grid; place-items: center;
    width: 4.5rem; height: 4.5rem; padding: 0; border: 0; background: none; cursor: pointer;
    transform: translate(-50%, -50%);
    opacity: 0; animation: rise 1.1s var(--ease-expo) .9s both;
  }
  .tour-marker[data-placed] { opacity: 1; }
  .tour-ring, .tour-dot { grid-area: 1 / 1; border-radius: 999px; }
  .tour-dot { width: 1.1rem; height: 1.1rem; background: var(--color-gold-light); box-shadow: 0 0 0 4px rgb(30 26 24 / .35), 0 0 24px rgb(227 202 146 / .9); }
  .tour-ring { width: 1.1rem; height: 1.1rem; border: 2px solid var(--color-gold-light); animation: tour-pulse 2.6s var(--ease-smooth) infinite; }
  .tour-ring-2 { animation-delay: 1.3s; }
  @keyframes tour-pulse { 0% { transform: scale(1); opacity: .9; } 100% { transform: scale(4.2); opacity: 0; } }
  .tour-label {
    position: absolute; left: 50%; top: 100%; transform: translate(-50%, .2rem);
    white-space: nowrap; font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    color: var(--color-cream); text-shadow: 0 1px 10px rgb(0 0 0 / .8);
  }
  .tour-marker:hover .tour-dot { background: #fff; }

  /* Viewer */
  .tour { max-width: 100vw; max-height: 100vh; width: 100vw; height: 100dvh; margin: 0; padding: 0; border: 0; background: #120d0c; color: var(--color-cream); }
  .tour::backdrop { background: rgb(18 13 12 / .96); }
  .tour[open] { animation: tour-in .5s var(--ease-expo); }
  @keyframes tour-in { from { opacity: 0; transform: scale(1.02); } to { opacity: 1; transform: none; } }
  .tour-stage { position: absolute; inset: 0; }
  .tour-slide { position: absolute; inset: 0; margin: 0; display: grid; grid-template-rows: 1fr auto; animation: tour-fade .6s var(--ease-expo); }
  @keyframes tour-fade { from { opacity: 0; transform: scale(1.02); } to { opacity: 1; transform: none; } }
  .tour-slide :global(picture) { min-height: 0; display: block; padding: 4.5rem 1rem 0; }
  .tour-slide :global(img) { max-height: calc(100dvh - 11.5rem); }
  .tour-slide figcaption { display: grid; gap: .25rem; justify-items: center; text-align: center; padding: 1.25rem 1rem 5.5rem; }
  .tour-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .tour-note { color: rgb(251 248 244 / .75); max-width: 40rem; }
  .tour-btn {
    position: absolute; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px;
    border: 1px solid rgb(251 248 244 / .25); background: rgb(251 248 244 / .08); color: var(--color-cream);
    backdrop-filter: blur(8px); cursor: pointer; transition: background .3s, transform .45s var(--ease-expo);
  }
  .tour-btn:hover { background: rgb(251 248 244 / .18); transform: scale(1.06); }
  .tour-close { top: 1.1rem; right: 1.1rem; }
  .tour-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .tour-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .tour-prev:hover, .tour-next:hover { transform: translateY(-50%) scale(1.06); }
  .tour-dots { position: absolute; left: 50%; bottom: 1.5rem; transform: translateX(-50%); display: flex; gap: .6rem; padding: .6rem .9rem; border-radius: 999px; background: rgb(0 0 0 / .35); }
  .tour-dots button { width: .55rem; height: .55rem; padding: 0; border: 0; border-radius: 999px; background: rgb(251 248 244 / .35); cursor: pointer; transition: transform .4s var(--ease-expo), background .3s; }
  .tour-dots button[aria-selected='true'] { background: var(--color-gold-light); transform: scale(1.35); }
  @media (prefers-reduced-motion: reduce) { .tour-ring { animation: none; opacity: .6; transform: scale(2.2); } .tour-marker { animation: none; } }
</style>

<script>
  const marker = document.querySelector<HTMLElement>('[data-tour-open]');
  const dialog = document.getElementById('store-tour') as HTMLDialogElement | null;
  if (marker && dialog) {
    // Pin the marker to the door: map a fraction of the photo onto the rendered, object-fit:cover image.
    const img = marker.parentElement?.querySelector<HTMLImageElement>('img');
    const place = () => {
      if (!img || !img.naturalWidth) return;
      const box = img.getBoundingClientRect(), host = marker.offsetParent?.getBoundingClientRect() ?? box;
      const scale = Math.max(box.width / img.naturalWidth, box.height / img.naturalHeight);
      const w = img.naturalWidth * scale, h = img.naturalHeight * scale;
      const [ox, oy] = (getComputedStyle(img).objectPosition.split(' ').map(parseFloat).concat([50, 50]) as number[]);
      const left = box.left + (box.width - w) * (ox / 100), top = box.top + (box.height - h) * (oy / 100);
      const mx = Number(marker.style.getPropertyValue('--mx')), my = Number(marker.style.getPropertyValue('--my'));
      marker.style.left = `${left + w * mx - host.left}px`;
      marker.style.top = `${top + h * my - host.top}px`;
      marker.dataset.placed = '';
    };
    if (img?.complete) place(); else img?.addEventListener('load', place, { once: true });
    addEventListener('resize', place);

    const slides = [...dialog.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...dialog.querySelectorAll<HTMLButtonElement>('[data-tour-go]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.hidden = k !== i; });
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
    };
    marker.addEventListener('click', () => { dialog.showModal(); document.documentElement.style.overflow = 'hidden'; });
    dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
    dialog.querySelector('[data-tour-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-tour-prev]')?.addEventListener('click', () => show(i - 1));
    dialog.querySelector('[data-tour-next]')?.addEventListener('click', () => show(i + 1));
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.tourGo))));
    dialog.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    let x0 = 0;
    dialog.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    dialog.addEventListener('pointerup', (e) => { const dx = e.clientX - x0; if (Math.abs(dx) > 48) show(dx < 0 ? i + 1 : i - 1); });
  }
</script>

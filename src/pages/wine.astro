---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImageSlot from '../components/ImageSlot.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ActionButtons from '../components/ActionButtons.astro';
import Icon from '../components/Icon.astro';
import { site, telHref } from '../site.config';
import wine from '../data/wine.json';
import { rotationIndex } from '../lib/rotation';
import { findPhoto } from '../lib/photos';

// Staff picks: one wine from each group, rotating every few days (see wine.json).
const { rotateEveryDays, startDate, groups } = wine.staffPicks;
const period = rotationIndex(rotateEveryDays, startDate);
const pickItems = groups.flatMap((g, gi) => {
  const wines = g.wines.filter((w) => findPhoto(w.photo));
  return wines.map((w, wi) => ({
    name: w.name,
    meta: w.style,
    note: w.note,
    tag: g.label,
    photo: w.photo,
    hidden: wi !== period % wines.length,
    attrs: { 'data-pick-group': String(gi), 'data-pick-index': String(wi), 'data-pick-count': String(wines.length) },
  }));
});
---
<BaseLayout
  title="Palace Liquor | Wine Shop in Clawson, MI"
  description="Looking for a wine shop in Clawson, MI? Palace Liquor carries hand-picked reds, whites, rosé and sparkling from around the world, plus staff picks and special orders."
>
  <Hero
    eyebrow="Fine wine"
    title="Pour something<br />worth talking about."
    subtitle="Hand-picked bottles from the world's great regions, for a Tuesday dinner or a once-a-year celebration."
    photo="hero-wine.jpg"
    photoAlt="Wine bottles on the shelf at Palace Liquor"
  >
    <ActionButtons />
  </Hero>

  <section class="py-16 sm:py-24" aria-labelledby="styles-title">
    <div class="container-x">
      <SectionHeading id="styles-title" eyebrow="Shop by style" title="Find your style." intro="Not sure where to start? Tell us what you're cooking or what you usually like, and we'll point you to a bottle." />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {wine.styles.map((s) => (
          <li class="card reveal p-6">
            <Icon name="wine" class="h-7 w-7 text-burgundy" />
            <h3 class="mt-3 text-xl">{s.name}</h3>
            <p class="mt-1 text-muted">{s.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-ink py-16 text-cream sm:py-24" aria-labelledby="regions-title">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading id="regions-title" tone="dark" eyebrow="Around the world" title="Regions we love." intro="From Old World classics to Michigan's own vineyards." />
        <ul class="reveal mt-8 flex flex-wrap gap-2">
          {wine.regions.map((r) => <li class="rounded-full border border-gold/40 px-4 py-2 text-cream/90">{r}</li>)}
        </ul>
      </div>
      <div class="reveal overflow-hidden rounded-2xl">
        <ImageSlot photo="wine-wall.jpg" alt="The wine wall at Palace Liquor" />
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24" aria-labelledby="picks-title">
    <div class="container-x">
      <SectionHeading id="picks-title" eyebrow="From our team" title="Staff picks." intro={`A Michigan wine, a Cabernet and a Pinot Grigio we love. New picks every ${rotateEveryDays} days.`} />
      <div class="mt-10" data-staff-picks data-rotate-days={rotateEveryDays} data-start-date={startDate}>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label="Wine staff picks">
          {pickItems.map((w) => (
            <li {...w.attrs} hidden={w.hidden} class="card reveal flex flex-col overflow-hidden">
              <ImageSlot photo={w.photo} alt={w.name} tone="light" aspect="aspect-[4/5]" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
              <div class="flex flex-1 flex-col p-6">
                <span class="self-start rounded-full bg-burgundy px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cream">{w.tag}</span>
                <p class="mt-3 font-display text-2xl font-bold leading-snug">{w.name}</p>
                <p class="mt-1 text-sm text-muted">{w.meta}</p>
                <p class="mt-3 text-muted">{w.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBanner
    eyebrow="Special orders"
    title="Looking for a specific bottle?"
    text="Ask us about special orders. If our distributors can get it, we'll do our best to bring it in for you."
  >
    <a href={telHref} class="btn btn-gold"><Icon name="phone" class="h-5 w-5" /> Call {site.phone}</a>
  </CtaBanner>
</BaseLayout>

<script>
  // Keep the staff picks current between site updates (same rule as the build).
  import { rotationIndex } from '../lib/rotation';
  const box = document.querySelector<HTMLElement>('[data-staff-picks]');
  if (box) {
    const period = rotationIndex(Number(box.dataset.rotateDays) || 3, box.dataset.startDate);
    box.querySelectorAll<HTMLElement>('[data-pick-group]').forEach((li) => {
      li.hidden = Number(li.dataset.pickIndex) !== period % Number(li.dataset.pickCount);
    });
  }
</script>

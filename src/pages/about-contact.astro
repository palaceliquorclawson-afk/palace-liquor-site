---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImageSlot from '../components/ImageSlot.astro';
import HoursTable from '../components/HoursTable.astro';
import Map from '../components/Map.astro';
import GoogleReviewButton from '../components/GoogleReviewButton.astro';
import Text from '../components/Text.astro';
import Icon from '../components/Icon.astro';
import { site, telHref, directionsUrl, isPlaceholder, socialLinks } from '../site.config';
import { findPhoto, allCredits } from '../lib/photos';

// ✏️ Edit your store story here. Each line is one paragraph.
const story = [
  'Palace Liquor is Clawson’s neighborhood bottle shop on 14 Mile Road: a place where a rare bourbon, a special-occasion wine and a cold six-pack on the way home all get the same friendly welcome.',
  'We keep our shelves stocked with fine wine, Michigan craft beer, a deep bourbon and whiskey selection and a well-kept humidor. Spirits are always at Michigan state minimum pricing, and when allocated bottles come in, they go straight on the shelf for our customers. No lists, no games.',
  'Planning a party? We’ll help with that too, from kegs and tables to a full drink order delivered to your door. Stop in and say hi. We’d love to help you find something great.',
];

// Your own store photos. Each shows once you add the file to src/assets/photos/.
const storePhotos = [
  { photo: 'storefront.jpg', alt: 'Palace Liquor storefront on 14 Mile Road', aspect: 'aspect-[16/10]', wide: true },
  { photo: 'team.jpg', alt: 'The Palace Liquor team', aspect: 'aspect-square', wide: false },
  { photo: 'inside.jpg', alt: 'Inside Palace Liquor', aspect: 'aspect-square', wide: false },
].filter((p) => findPhoto(p.photo));
const credits = allCredits();
---
<BaseLayout
  title="About & Contact | Palace Liquor, Clawson, MI"
  description="Palace Liquor & Deli Shop at 650 W 14 Mile Rd, Clawson, MI 48017. Hours, directions, phone and our story. Call (248) 435-4888."
>
  <Hero eyebrow="About & contact" title="Your neighborhood<br />bottle shop." photo="hero-about.jpg" photoAlt="The front of Palace Liquor in Clawson" />

  <section class="py-16 sm:py-24" aria-labelledby="story-title">
    <div class:list={['container-x grid items-center gap-10', storePhotos.length > 0 && 'lg:grid-cols-2']}>
      <div class:list={[storePhotos.length === 0 && 'max-w-3xl']}>
        <SectionHeading id="story-title" eyebrow="Our story" title="Clawson's place for the good stuff." />
        <div class="reveal mt-6 grid gap-4 text-lg">
          {story.map((p) => <Text as="p" value={p} />)}
        </div>
      </div>
      {storePhotos.length > 0 && (
        <div class="grid grid-cols-2 gap-4">
          {storePhotos.map((p) => (
            <div class:list={['reveal overflow-hidden rounded-2xl', (p.wide || storePhotos.length === 1) && 'col-span-2']}>
              <ImageSlot photo={p.photo} alt={p.alt} aspect={p.aspect} />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="border-t border-line bg-paper py-16 sm:py-24" aria-labelledby="contact-title">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <SectionHeading id="contact-title" eyebrow="Contact" title="Come see us." />
        <address class="reveal mt-8 grid gap-4 not-italic">
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="flex gap-3 text-lg hover:text-burgundy">
            <Icon name="pin" class="mt-1 h-5 w-5 flex-none text-burgundy" />
            <span>{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}<br /><span class="font-semibold text-burgundy underline">Get directions</span><span class="sr-only"> (opens in a new tab)</span></span>
          </a>
          <a href={telHref} class="flex gap-3 text-lg hover:text-burgundy">
            <Icon name="phone" class="mt-1 h-5 w-5 flex-none text-burgundy" /> {site.phone}
          </a>
          <p class="flex gap-3 text-lg">
            <Icon name="mail" class="mt-1 h-5 w-5 flex-none text-burgundy" />
            {isPlaceholder(site.email) ? <Text value={site.email} /> : <a href={`mailto:${site.email}`} class="hover:text-burgundy">{site.email}</a>}
          </p>
          {socialLinks.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="flex gap-3 text-lg hover:text-burgundy">
              <Icon name={s.icon as 'instagram'} class="mt-1 h-5 w-5 flex-none text-burgundy" /> {s.name}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          ))}
          <GoogleReviewButton variant="link" class="text-lg text-burgundy" />
        </address>
        <div class="reveal mt-8"><HoursTable /></div>
      </div>
      <Map class="reveal self-start" />
    </div>
  </section>
  {credits.length > 0 && (
    <section class="border-t border-line py-10" aria-labelledby="credits-title">
      <div class="container-x">
        <details class="text-sm text-muted">
          <summary id="credits-title" class="cursor-pointer font-semibold text-ink">Photo credits</summary>
          <p class="mt-3">Some product and scene photos on this site are from <a class="underline" href="https://commons.wikimedia.org" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>, used under their free licenses. Photos show the products and styles we carry, not our store.</p>
          <ul class="mt-3 grid gap-1 sm:grid-cols-2">
            {credits.map((c) => (
              <li>
                <a class="underline" href={c.source} target="_blank" rel="noopener noreferrer">{c.title}</a>
                {' '}by {c.author}
                {c.licenseUrl ? <>, <a class="underline" href={c.licenseUrl} target="_blank" rel="noopener noreferrer">{c.license}</a></> : <>, {c.license}</>}
              </li>
            ))}
          </ul>
        </details>
      </div>
    </section>
  )}
</BaseLayout>

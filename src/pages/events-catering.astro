---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBanner from '../components/CtaBanner.astro';
import EventForm from '../components/EventForm.astro';
import Icon from '../components/Icon.astro';
import { site, telHref } from '../site.config';
import events from '../data/events.json';

const offerings = [
  { icon: 'beer', label: 'Beer' },
  { icon: 'wine', label: 'Wine' },
  { icon: 'spirits', label: 'Spirits' },
  { icon: 'ice', label: 'Ice' },
  { icon: 'table', label: 'Rental Tables' },
] as const;

const perfectFor = ['Weddings', 'Graduation parties', 'Birthdays', 'Baby showers', 'Corporate events', 'Backyard BBQs', 'Holiday parties', 'And more'];

const steps = [
  { t: 'Tell us your guest count.', d: 'Call or fill out the form below with your date, event type and number of guests.' },
  { t: 'We recommend exactly what you need.', d: 'We put together the right mix of beer, wine, spirits and ice so you don’t over- or under-buy.' },
  { t: 'We deliver everything to your event.', d: 'Fast, reliable local delivery right to your door or venue.' },
  { t: 'You enjoy your event.', d: 'Relax and spend time with your guests. We handled the drinks.' },
];

const services = [
  'Custom beverage recommendations',
  'Bulk pricing for large events',
  'Special orders for your favorite brands',
  'Keg & tapper rental available',
  'Table rentals',
  'Fast, reliable local delivery',
];

type Upcoming = { date: string; title: string; time?: string; details?: string };
const upcoming = (events.upcoming as Upcoming[])
  .filter((e) => new Date(`${e.date}T23:59:59`) >= new Date())
  .sort((a, b) => a.date.localeCompare(b.date));
---
<BaseLayout
  title="Palace Liquor | Event & Party Drink Catering in Clawson, MI"
  description="Party and event drink catering in Clawson, MI. Weddings, graduation parties, corporate events and BBQs: custom recommendations, bulk pricing, kegs, tables, ice and local delivery from Palace Liquor."
  schema={{
    '@type': 'Service',
    serviceType: 'Event beverage catering and delivery',
    provider: { '@id': `${site.url}/#store` },
    areaServed: { '@type': 'City', name: 'Clawson, Michigan' },
  }}
>
  <Hero
    eyebrow="Events & catering"
    title="Let us handle<br />the drinks."
    subtitle="Beer, wine, spirits, ice and tables for your next party, recommended by us and delivered to your door."
    tone="burgundy"
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="#inquiry" class="btn btn-gold">Start your order <Icon name="arrow" class="h-5 w-5" /></a>
      <a href={telHref} class="btn btn-outline-light"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
    </div>
  </Hero>

  <!-- Icon row -->
  <section class="border-b border-line bg-paper py-10" aria-label="What we provide">
    <ul class="container-x grid grid-cols-3 gap-6 sm:grid-cols-5">
      {offerings.map((o) => (
        <li class="reveal flex flex-col items-center gap-2 text-center">
          <span class="grid h-16 w-16 place-items-center rounded-full bg-burgundy text-cream"><Icon name={o.icon} class="h-8 w-8" /></span>
          <span class="font-semibold uppercase tracking-wide">{o.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Perfect for + services -->
  <section class="py-16 sm:py-24" aria-labelledby="perfect-title">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHeading id="perfect-title" eyebrow="Perfect for" title="Any reason to celebrate." />
        <ul class="reveal mt-8 flex flex-wrap gap-2">
          {perfectFor.map((p) => <li class="rounded-full bg-ink px-4 py-2 font-medium text-cream">{p}</li>)}
        </ul>
      </div>
      <div>
        <SectionHeading eyebrow="What we offer" title="Services." />
        <ul class="reveal mt-8 grid gap-3">
          {services.map((s) => (
            <li class="flex items-center gap-3 text-lg">
              <span class="grid h-8 w-8 flex-none place-items-center rounded-full bg-burgundy text-cream"><Icon name="check" class="h-5 w-5" /></span>
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-ink py-16 text-cream sm:py-24" aria-labelledby="how-title">
    <div class="container-x">
      <SectionHeading id="how-title" tone="dark" eyebrow="How it works" title="Four easy steps." />
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="reveal rounded-2xl border border-white/10 bg-ink-2 p-6">
            <span class="font-display text-5xl font-bold text-gold" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-3 text-xl"><span class="sr-only">Step {i + 1}: </span>{s.t}</h3>
            <p class="mt-2 text-cream/75">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Offer -->
  <section class="py-12" aria-labelledby="offer-title">
    <div class="container-x">
      <div class="reveal relative overflow-hidden rounded-2xl border-2 border-dashed border-burgundy bg-paper p-6 sm:p-10">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <span class="grid h-20 w-20 flex-none place-items-center rounded-2xl bg-burgundy text-cream"><Icon name="ice" class="h-10 w-10" /></span>
          <div>
            <p class="eyebrow text-burgundy">Special offer</p>
            <h2 id="offer-title" class="mt-1 text-2xl sm:text-3xl">{site.cateringOffer.text}</h2>
            <p class="mt-1 text-lg text-muted">{site.cateringOffer.mention}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="pb-4" aria-labelledby="upcoming-title">
      <div class="container-x">
        <SectionHeading id="upcoming-title" eyebrow="At the store" title="Upcoming events." />
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {upcoming.map((e) => (
            <li class="card reveal flex gap-4 p-5">
              <div class="flex h-16 w-16 flex-none flex-col items-center justify-center rounded-xl bg-burgundy text-cream">
                <span class="text-xs uppercase">{new Date(`${e.date}T12:00:00`).toLocaleDateString('en-US', { month: 'short' })}</span>
                <span class="font-display text-2xl font-bold leading-none">{new Date(`${e.date}T12:00:00`).getDate()}</span>
              </div>
              <div>
                <h3 class="text-xl">{e.title}</h3>
                {e.time && <p class="text-muted">{e.time}</p>}
                {e.details && <p class="mt-1">{e.details}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Inquiry -->
  <section id="inquiry" class="py-16 sm:py-24" aria-labelledby="inquiry-title">
    <div class="container-x">
      <SectionHeading id="inquiry-title" eyebrow="Get a recommendation" title="Plan your drinks." intro="Use the estimator for a ballpark, then give us a call. We'll build your order and deliver it." />
      <div class="mt-10"><EventForm /></div>
    </div>
  </section>

  <CtaBanner title={`Call ${site.phone}<br />to get started today!`} text="Prefer to talk it through? Give us a call and we'll plan it together.">
    <a href={telHref} class="btn btn-gold px-8 text-lg"><Icon name="phone" class="h-5 w-5" /> Call {site.phone}</a>
  </CtaBanner>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Text from '../components/Text.astro';
import Icon from '../components/Icon.astro';
import { site, telHref, directionsUrl } from '../site.config';
import cigars from '../data/cigar-brands.json';
import pairings from '../data/cigar-pairings.json';
import CtaBanner from '../components/CtaBanner.astro';
import { findPhoto } from '../lib/photos';
import { Picture } from 'astro:assets';
---
<BaseLayout
  title="Palace Liquor | Cigars in Clawson, MI"
  description="Cigars in Clawson, MI. Palace Liquor keeps a humidor stocked with premium cigars from brands smokers love. Must be 21+ with valid ID."
>
  <Hero
    eyebrow="Cigars"
    title="Kept right.<br />Smoked slow."
    subtitle="A humidor stocked with premium cigars, kept at the right humidity so every smoke is ready when you are."
    photo="hero-cigars.jpg"
    photoAlt="Cigars in the Palace Liquor humidor"
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={telHref} class="btn btn-gold"><Icon name="phone" class="h-5 w-5" /> Call {site.phone}</a>
      <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light"><Icon name="pin" class="h-5 w-5" /> Get Directions<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </Hero>

  <section class="py-16 sm:py-24" aria-labelledby="humidor-title">
    <div class="container-x">
      <SectionHeading id="humidor-title" eyebrow="The humidor" title="Step inside." intro="Browse the humidor, ask what's new, or tell us what you usually smoke and we'll suggest something to try next. Everything is kept at proper humidity, so it draws the way it should." />
    </div>
  </section>

  <section class="bg-ink py-16 text-cream sm:py-24" aria-labelledby="brands-title">
    <div class="container-x">
      <SectionHeading id="brands-title" tone="dark" eyebrow="What we carry" title="Brands we carry." intro="Selection changes, so call to check on a specific cigar." />
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {cigars.brands.map((b) => (
          <li class="reveal rounded-xl border border-white/10 bg-ink-2 px-4 py-5 text-center font-display text-lg">
            <Text value={b} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 sm:py-24" aria-labelledby="pair-title">
    <div class="container-x">
      <SectionHeading id="pair-title" eyebrow="Cigars & bourbon" title="Pair it with a pour." intro="Not sure what to sip with your smoke? Here's where we'd start. Ask us and we'll tailor it to what you like." />
      <ul class="mt-10 grid gap-5 lg:grid-cols-3">
        {pairings.pairings.map((p) => (
          <li class="card reveal flex flex-col p-6 sm:p-7">
            <span class="self-start rounded-full bg-burgundy px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cream">{p.wrapper}</span>
            <h3 class="mt-4 text-2xl">{p.profile}</h3>
            <p class="mt-2 flex-1 text-muted">{p.note}</p>
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-burgundy">Try it with</p>
            <ul class="mt-3 grid gap-3">
              {p.bottles.map((b) => {
                const image = findPhoto(b.photo);
                return (
                  <li class="flex items-center gap-3">
                    {image ? (
                      <Picture src={image} alt="" formats={['avif', 'webp']} widths={[96, 144]} sizes="48px" loading="lazy" class="h-14 w-12 flex-none rounded-md object-cover" />
                    ) : (
                      <span class="grid h-14 w-12 flex-none place-items-center rounded-md bg-cream-2"><Icon name="bourbon" class="h-6 w-6 text-burgundy/60" /></span>
                    )}
                    <span class="font-display text-lg font-bold leading-snug">{b.name}</span>
                  </li>
                );
              })}
            </ul>
          </li>
        ))}
      </ul>
      <p class="reveal mt-6 text-sm text-muted">Bottle selection changes. Call and we'll tell you what's on the shelf today.</p>
    </div>
  </section>

  <CtaBanner
    eyebrow="Special orders"
    title="Buying for a wedding, golf outing<br />or the holidays?"
    text="We can order boxes and bundles for your event, and we'll do our best to track down a specific cigar you're after. Give us a call and tell us what you need."
    tone="ink"
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={telHref} class="btn btn-gold px-8 text-lg"><Icon name="phone" class="h-5 w-5" /> Call {site.phone}</a>
      <a href="/events-catering/" class="btn btn-outline-light">Planning a whole event? <Icon name="arrow" class="h-5 w-5" /></a>
    </div>
  </CtaBanner>

  <section class="py-14" aria-labelledby="id-title">
    <div class="container-x">
      <div class="reveal flex flex-col gap-4 rounded-2xl border-2 border-burgundy bg-paper p-6 sm:flex-row sm:items-center sm:p-8">
        <Icon name="id" class="h-12 w-12 flex-none text-burgundy" />
        <div>
          <h2 id="id-title" class="text-2xl">21+ with valid ID</h2>
          <p class="mt-1 text-muted">You must be 21 or older to buy cigars and other tobacco products. Please bring a valid, government-issued photo ID.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
